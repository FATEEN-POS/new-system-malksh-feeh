{
  "name": "fateen-pos-desktop",
  "productName": "Fateen POS",
  "version": "1.0.0",
  "description": "Fateen POS — نظام إدارة المبيعات والمخازن الذكي (Desktop)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "author": "Fateen POS",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "me.fateen1.pos",
    "productName": "Fateen POS",
    "directories": {
      "output": "../../dist-desktop"
    },
    "files": [
      "main.js",
      "preload.js",
      "../../*.html",
      "../../manifest.json",
      "../../sw.js",
      "../../src/**/*",
      "../../icons/**/*"
    ],
    "extraResources": [
      {
        "from": "../../",
        "to": "app",
        "filter": [
          "*.html",
          "manifest.json",
          "sw.js",
          "src/**",
          "icons/**"
        ]
      }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "../../icons/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
