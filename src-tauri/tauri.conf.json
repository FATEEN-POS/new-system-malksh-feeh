{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devPath": "http://localhost:3000",
    "distDir": "../"
  },
  "package": {
    "productName": "Fateen POS",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true
      }
    },
    "bundle": {
      "active": true,
      "category": "Business",
      "copyright": "2024 Fateen POS",
      "deb": {
        "depends": []
      },
      "externalBin": [],
      "icon": [],
      "identifier": "me.fateen1.pos",
